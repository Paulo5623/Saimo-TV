{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SaimoTV",
  "version": "1.6.4",
  "identifier": "tv.saimo.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "bun run desktop:dev:web",
    "beforeBuildCommand": "bun run desktop:build:web"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "TV Ligada",
    "category": "Entertainment",
    "shortDescription": "Canais, filmes e séries",
    "longDescription": "TV Ligada: canais ao vivo, filmes e séries com guia de programação em todos os seus dispositivos.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR", "English"]
      }
    }
  }
}
